<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
   "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
 <mapper namespace="com.example.demo.repository.DiagnosisResultsMapper">

<select id="findAll" resultType="com.example.demo.entity.Diagnosis_results">
SELECT id, name, character_id, diagnosed_at FROM diagnosis_results ORDER BY diagnosed_at DESC 
</select>
<select id="findById"  resultType="com.example.demo.entity.Diagnosis_results">
 SELECT id, name, character_id, diagnosed_at FROM diagnosis_results WHERE id = #{id} 
 </select>


    <resultMap id="diagnosisResultsResultMap" type="com.example.demo.entity.DiagnosisResult">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="characterId" column="character_id"/>
        <result property="diagnosedAt" column="diagnosed_at"/>
    </resultMap>
 
    <select id="findAll" resultMap="diagnosisResultsResultMap">
        SELECT id, name, character_id, diagnosed_at
        FROM diagnosis_results
        ORDER BY diagnosed_at DESC
    </select>
 
    <select id="findById" parameterType="long" resultMap="diagnosisResultsResultMap">
        SELECT id, name, character_id, diagnosed_at
        FROM diagnosis_results
        WHERE id = #{id}
    </select>
 
    <insert id="insert" parameterType="com.example.demo.entity.DiagnosisResult"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO diagnosis_results (name, character_id, diagnosed_at)
        VALUES (#{name}, #{characterId}, #{diagnosedAt})
    </insert>
 
    <delete id="deleteById" parameterType="long">
        DELETE FROM diagnosis_results WHERE id = #{id}
    </delete>
</mapper>