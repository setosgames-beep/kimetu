<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.repository.CharacterMapper">
	
	<!-- 全キャラクターの取得 -->
     <select id="findAll" resultType="com.example.demo.entity.Characters">
         SELECT id, name, description, image_path AS imagePath
         FROM characters
    </select>
	
    <!-- IDでキャラクターを1件取得（診断結果画面にキャラ情報を貼り付けるために使用） -->
     <select id="findById" resultType="com.example.demo.entity.Characters">
         SELECT id, name, description, image_path AS imagePath
         FROM characters
         WHERE id = #{id}
    </select>
    
</mapper>