<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
        <mapper namespace="com.example.demo.repository.QuestionMapper">

<select id="findAllOrderByDisplayOrder" resultType="com.example.demo.entity.Questions"> 
SELECT id, question_text, display_order FROM questions ORDER BY display_order 
</select>
<select id="findById"  resultType="com.example.demo.entity.Questions"> 
SELECT id, question_text, display_order FROM questions WHERE id = #{id} 
</select>
