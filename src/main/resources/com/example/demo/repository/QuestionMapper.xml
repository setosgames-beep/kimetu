<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.repository.QuestionMapper">
	
	<!-- 全設問を取得（診断開始時に画面に出題するため、登録順でまとめて取得） -->
	<select id="findAll" resultType="com.example.demo.entity.Questions"> 
		SELECT id, body FROM questions ORDER BY sort_order ASC
	</select>
	
	<!-- 特定の設問を取得（同点が出た時） -->
	<select id="findById" resultType="com.example.demo.entity.Questions"> 
		SELECT id, body FROM questions ORDER BY sort_order ASC
	</select>
	
</mapper>